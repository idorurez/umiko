(footprint "SK6812-4020-SideView"
  (version 20240108)
  (generator "umiko-rev2")
  (generator_version "1.0")
  (layer "F.Cu")
  (descr "SK6812/WS2812B SIDE 4020 side-view addressable RGB LED. Package height varies significantly by manufacturer: SK6812 datasheet nominal 1.90mm; some WS2812B-branded AliExpress variants ship at ~1.60-2.00mm. Footprint uses 2.00mm as worst-case for the 3D model to be safe for case clearance. Package: 4.00 x 2.00 mm on PCB, 4 inline pads 1.0mm pitch, C0.6 chamfer. Pad 1=DIN 2=VDD 3=DOUT 4=GND. Emit face +Y (toward board edge). Emit direction shown on F.Fab (engineering) layer so it stays visible when F.SilkS is disabled for custom silk graphics. Interchangeable with WS2812B-4020, SK6812SIDE-A, SK6805 SIDE, OPSCO/Normand equivalents; all accept the WS2812 800kHz GRB protocol. VERIFY the exact height of the part you order for case-clearance analysis.")
  (tags "SK6812 WS2812B SIDE 4020 addressable LED side-view")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.0) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.1))))
