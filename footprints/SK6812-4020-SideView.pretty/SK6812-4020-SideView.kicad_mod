(footprint "SK6812-4020-SideView"
  (version 20240108)
  (generator "Umiko Rev2 subagent")
  (generator_version "1.0")
  (layer "F.Cu")
  (descr "SK6812 / SK6805 SIDE 4020 4.0x2.0x1.5mm side-view addressable RGB LED, 4 inline pads, 1.0mm pitch, source: Shenzhen Normand SK68XX SIDE datasheet Rev01 2017-08-15 / OPSCO SK6812SIDE-A variant")
  (tags "SK6812 SIDE 4020 addressable LED side-view")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "SK6812-4020-SideView" (at 0 2.2) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_line (start -2.0 -1.0) (end 2.0 -1.0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 2.0 -1.0) (end 2.0 1.0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 2.0 1.0) (end -2.0 1.0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -2.0 1.0) (end -2.0 -1.0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  ; Emitting face is +Y (toward board edge, outward). Arrow on Silk.
  (fp_line (start 0 1.1) (end 0 1.6) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -0.25 1.35) (end 0 1.6) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 0.25 1.35) (end 0 1.6) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_text user "EMIT → +Y" (at 0 1.95) (layer "F.SilkS") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "DIN VDD DOUT GND (1-4)" (at 0 -1.8) (layer "F.SilkS") (effects (font (size 0.35 0.35) (thickness 0.06))))
  ; Pads - 4 inline, 1.0mm pitch, 0.6 x 0.9mm recommended land, per Normand SK68XX SIDE datasheet and Adafruit 4691 notes.
  ; Pin order from datasheet: 1=DIN, 2=VDD, 3=DOUT, 4=GND/VSS. Left to right when emitting face +Y, pins at bottom side.
  (pad "1" smd rect (at -1.5 0) (size 0.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at -0.5 0) (size 0.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "3" smd rect (at 0.5 0) (size 0.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "4" smd rect (at 1.5 0) (size 0.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask"))
  ; Courtyard - 0.5mm clearance around package, plus 0.25mm for placement tolerance near edge.
  (fp_rect (start -2.6 -1.6) (end 2.6 1.8) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  ; Keepout note for edge clearance
  (fp_text user "Keep 0.8mm clearance to Edge.Cuts, emitting face toward edge" (at 0 -2.6) (layer "Cmts.User") (effects (font (size 0.4 0.4) (thickness 0.06))))
  (fp_text user "JLC rotation 0 deg = DIN left, check strip feed" (at 0 2.8) (layer "Cmts.User") (effects (font (size 0.4 0.4) (thickness 0.06))))
  (property "LCSC_PN" "TBD - No LCSC SIDE 4020 found 2026-08-28, use SK6812SIDE-A-RVS")
  (property "MPN" "SK6812SIDE-A or SK6812-EC3210 SIDE 4.0x2.0x1.5mm")
  (property "Datasheet" "https://pt.slideshare.net/DaisyXu23/sk6812-side-4020-led-datasheet + https://os.mbed.com/media/uploads/billyi/sk6812-4020_led_side.pdf (mbed sunset placeholder)")
  (model "${KIPRJMOD}/footprints/SK6812-4020-SideView.wrl" (at (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
